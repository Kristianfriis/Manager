@page "/planets"
@using Manager.Client.Components
@using Manager.Client.Models
@using Manager.Client.Services
@inject GameService GameService
@inject NavigationManager Navigation

<PageTitle>Planets</PageTitle>

<h2>Planets</h2>

<MudOverlay Visible="loading" DarkBackground="true">
    <MudProgressCircular Color="Color.Secondary" Indeterminate="true" />
</MudOverlay>

<MudGrid>
    @foreach (var planet in planets)
    {
        <MudItem xs="12" md="6">
            <MudCard>
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6" Align="Align.Center">@planet.Name</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    <MudStack>
                        <MudGrid Justify="Justify.Center">
                            <CustomIcon Icon="CustomIconEnum.World" Size="4" />
                        </MudGrid>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => VisitPlanet(planet.Id))"
                                   Class="mt-2">Visit</MudButton>
                    </MudStack>
                </MudCardContent>
            </MudCard>
        </MudItem>
    }

    @* <MudItem xs="12" md="6">
        <MudCard>
            <MudCardContent>
                <h3>Create Planet</h3>
                <MudTextField @bind-Value="@newPlanetName" Placeholder="Planet name" Variant="Variant.Outlined" />
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@CreatePlanet"
                           Disabled="@(string.IsNullOrWhiteSpace(newPlanetName) || creating)" Class="mt-2">
                    Create
                </MudButton>
            </MudCardContent>
        </MudCard>
    </MudItem> *@
</MudGrid>

@code {
    string newPlanetName = "";
    @* bool creating; *@
    bool loading = false;
    IEnumerable<PlanetLookupDto> planets = [];

    protected override async Task OnInitializedAsync()
    {
        loading = true;
        planets = await GameService.ListPlanetsAsync();
        loading = false;
    }

    async Task CreatePlanet()
    {
        @* creating = true; *@
        try
        {
            var planet = await GameService.CreatePlanetAsync(newPlanetName);
            if (planet is not null)
                Navigation.NavigateTo($"/planet/{planet.Id}");
        }
        finally
        {
            @* creating = false; *@
        }
    }

    void VisitPlanet(int id)
    {
        Navigation.NavigateTo($"/planet/{id}");
    }
}
