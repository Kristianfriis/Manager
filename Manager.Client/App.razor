@using Manager.Client.Services
@inject AppState AppState
@inject LocalStorageService LocalStorage
@inject ISnackbar Snackbar
@inject PlayerService PlayerService

<MudThemeProvider @ref="_mudThemeProvider" @bind-IsDarkMode="_isDarkMode" Theme="CustomThemes.Spacelabtheme"/>
<MudDialogProvider />
<MudSnackbarProvider />

<Router AppAssembly="@typeof(App).Assembly" NotFoundPage="typeof(Pages.NotFound)">
    <Found Context="routeData">
        <RouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)" />
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
</Router>


@code {
    private bool _isDarkMode;
    private MudThemeProvider _mudThemeProvider;

    protected override async Task OnInitializedAsync()
    {
        var storedPlayerName = await LocalStorage.GetItemAsync<string>("PlayerName");
        Console.WriteLine($"Retrieved player name from local storage: {storedPlayerName}");
        if (!string.IsNullOrWhiteSpace(storedPlayerName))
        {
            var (success, player, message) = await PlayerService.GetPlayerAsync(storedPlayerName);
            if (!success)
            {
                Snackbar.Configuration.PositionClass = Defaults.Classes.Position.BottomCenter;
                Snackbar.Add(message ?? "An error occurred while retrieving the player.", Severity.Normal);
            }
            else            
            {
                if (player == null)
                {
                    Snackbar.Configuration.PositionClass = Defaults.Classes.Position.BottomCenter;
                    Snackbar.Add("Player data is null.", Severity.Normal);
                    return;
                }
                
                AppState.SetPlayerName(player.Name);
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _isDarkMode = await _mudThemeProvider.GetSystemDarkModeAsync();
            await _mudThemeProvider.WatchSystemDarkModeAsync(OnSystemDarkModeChanged);
            StateHasChanged();
        }
    }

    private Task OnSystemDarkModeChanged(bool newValue)
    {
        _isDarkMode = newValue;
        StateHasChanged();
        return Task.CompletedTask;
    }
}