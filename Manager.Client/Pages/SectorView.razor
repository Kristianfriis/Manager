@page "/sector/{SectorId:int}"
@using Manager.Client.Services
@using Microsoft.AspNetCore.SignalR.Client
@using Microsoft.Extensions.Configuration
@implements IAsyncDisposable
@inject GameService GameService
@inject AppState AppState
@inject NavigationManager Navigation
@inject IConfiguration Configuration
@inject IDialogService DialogService

<PageTitle>@(sector?.Name ?? "Sector")</PageTitle>

<MudLink Href="/sectors">← Back to Sectors</MudLink>

@if (!string.IsNullOrEmpty(message))
{
    <MudAlert Severity="@severity" Class="mt-4 mb-4">
        @message
    </MudAlert>
}

@if (sector is not null)
{
    <MudText Typo="Typo.h4" Class="mt-4">@sector.Name</MudText>
    <MudText Typo="Typo.body2" Class="mb-4">Claim zones and send ships to attack enemy-held territory. Outer rings are weaker — fight your way to the center for the biggest boosts!</MudText>

    @foreach (var ring in RingsInOrder)
    {
        var zones = sector.Zones.Where(z => z.Ring == ring).ToList();
        if (zones.Count == 0) continue;

        var boostPct = zones.First().BoostPercentage * 100;

        <MudText Typo="Typo.subtitle1" Class="mt-6 mb-2 mud-text-secondary">
            Ring @ring @(ring == 0 ? "(Center — Best)" : "") — @boostPct% Boost
        </MudText>

        <div class="ring-row @(ring == 0 ? "ring-center" : "") @(ring == 3 ? "ring-outer" : "")">
            @foreach (var zone in zones)
            {
                var isIncoming = incomingZoneIds.Contains(zone.Id);
                <MudCard Class="@ZoneCardClass(isIncoming)" Outlined="true">
                    <MudCardContent>
                        <span class="mud-chip mud-chip-text mud-chip-color-@BoostCssClass(zone.BoostType) mb-2">
                            @zone.BoostType +@(zone.BoostPercentage * 100)%
                        </span>

                        <MudText Typo="Typo.body2" Class="mud-text-secondary">
                            R@(zone.Ring)-P@(zone.Position)
                        </MudText>

                        <MudDivider Class="my-2" />

                        @if (zone.IsClaimed)
                        {
                            <MudText Typo="Typo.body2">
                                <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" />
                                @zone.OwnerName
                            </MudText>
                            <MudText Typo="Typo.body2">
                                <MudIcon Icon="@Icons.Material.Filled.Rocket" Size="Size.Small" />
                                @zone.ShipCount ships
                            </MudText>
                        }
                        else
                        {
                            <MudText Typo="Typo.body2" Class="mud-success-text">Unclaimed</MudText>
                            <MudText Typo="Typo.body2">0 ships</MudText>
                        }

                        @if (!zone.IsClaimed)
                        {
                            <MudButton Variant="Variant.Filled" Color="Color.Success"
                                       OnClick="@(() => OpenActionDialog(zone))"
                                       Disabled="@(string.IsNullOrWhiteSpace(AppState.PlayerName) || fleet.Count == 0)"
                                       FullWidth="true" Class="mt-2">
                                Claim
                            </MudButton>
                        }
                        else if (zone.OwnerId != AppState.PlayerId && zone.IsClaimed)
                        {
                            <MudButton Variant="Variant.Filled" Color="Color.Warning"
                                       OnClick="@(() => OpenActionDialog(zone))"
                                       Disabled="@(string.IsNullOrWhiteSpace(AppState.PlayerName) || fleet.Count == 0)"
                                       FullWidth="true" Class="mt-2">
                                Attack
                            </MudButton>
                        }
                        else if (zone.OwnerId == AppState.PlayerId)
                        {
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                                       OnClick="@(() => OpenManageDialog(zone))"
                                       FullWidth="true" Class="mt-2">
                                Manage
                            </MudButton>
                        }
                    </MudCardContent>
                </MudCard>
            }
        </div>
    }

    @* Fleet movements *@
    @if (movements.Count > 0)
    {
        <MudPaper Class="pa-4 mt-6">
            <MudText Typo="Typo.h6">Fleet Movements</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">Live updates via SignalR</MudText>

            @foreach (var mv in movements.OrderBy(m => m.ArrivalTime))
            {
                <MudCard Outlined="true" Class="@MovementCardClass(mv)">
                    <MudCardContent>
                        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                            <MudIcon Icon="@Icons.Material.Filled.Flight" Class="@(mv.IsEnRoute ? "mud-info-text" : mv.AttackerWon == true ? "mud-success-text" : "mud-error-text")" />
                            <MudText Typo="Typo.body2">
                                @(mv.IsClaim ? "Claim" : "Attack") — R@(mv.Ring)-P@(mv.Position)
                            </MudText>
                            <MudText Typo="Typo.body2" Class="mud-text-secondary">
                                @mv.ShipCount ship@(mv.ShipCount > 1 ? "s" : "")
                            </MudText>
                        </MudStack>

                        @if (mv.IsEnRoute)
                        {
                            <MudText Typo="Typo.body2" Class="mud-info-text mt-1">
                                Arriving in @FormatTime(mv.TimeUntilArrival)…
                            </MudText>
                        }
                        else if (mv.Resolved)
                        {
                            <MudText Typo="Typo.body2" Class="mt-1">
                                @if (mv.AttackerWon == true)
                                {
                                    <span class="mud-success-text">✓ Victory! @mv.RemainingAttackerShips ship@(mv.RemainingAttackerShips != 1 ? "s" : "") remaining.</span>
                                }
                                else
                                {
                                    <span class="mud-error-text">✗ Defeated! Lost @mv.ShipsLost ship@(mv.ShipsLost != 1 ? "s" : "").</span>
                                }
                            </MudText>
                        }
                    </MudCardContent>
                </MudCard>
            }
        </MudPaper>
    }

    <MudPaper Class="pa-4 mt-6">
        <MudText Typo="Typo.h6">Your Fleet</MudText>
        @if (fleet.Count > 0)
        {
            <MudStack Row="true" Spacing="4" Class="mt-2">
                @foreach (var ship in fleet)
                {
                    <MudText Typo="Typo.body2">
                        <MudIcon Icon="@Icons.Material.Filled.Rocket" Class="mud-primary-text" Size="Size.Small" />
                        @ship.Type: @ship.Count
                    </MudText>
                }
            </MudStack>
            <MudText Typo="Typo.body2" Class="mud-text-secondary mt-2">
                Total: <strong>@fleet.Sum(f => f.Count)</strong> ships
            </MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary mt-1">Claiming costs 1 ship. Attacking costs however many you send.</MudText>
        }
        else
        {
            <MudText Typo="Typo.body2" Class="mt-2">No ships yet. Build them at your planets' shipyards.</MudText>
        }
        <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="@(() => Navigation.NavigateTo("/fleet"))" Class="mt-2">
            Manage Fleet →
        </MudButton>
    </MudPaper>
}
else if (!loading)
{
    <MudAlert Severity="Severity.Warning" Class="mt-4">Sector not found.</MudAlert>
}

@code {
    [Parameter] public int SectorId { get; set; }

    SectorDetailDto? sector;
    string? message;
    Severity severity = Severity.Normal;
    bool loading = true;
    List<FleetMovementDto> movements = [];
    List<FleetDto> fleet = [];
    HashSet<int> incomingZoneIds = [];

    private HubConnection? hubConnection;

    static readonly int[] RingsInOrder = [3, 2, 1, 0];

    protected override async Task OnInitializedAsync()
    {
        if (string.IsNullOrWhiteSpace(AppState.PlayerName))
        {
            Navigation.NavigateTo("/");
            return;
        }

        await LoadAsync();

        var hubUrl = Configuration.GetValue<string>("ApiBaseUrl") ?? "http://localhost:5261";

        hubConnection = new HubConnectionBuilder()
            .WithUrl($"{hubUrl}/hub/movements")
            .WithAutomaticReconnect()
            .Build();

        hubConnection.On("MovementUpdated", async (SectorDetailDto sectorDetails) =>
        {
            sector = sectorDetails;
            await InvokeAsync(StateHasChanged);
        });

        hubConnection.Closed += async (error) =>
        {
            await Task.CompletedTask;
        };

        await hubConnection.StartAsync();
        await hubConnection.InvokeAsync("JoinSectorGroup", SectorId);
    }

    async Task OnMovementUpdated(SectorDetailDto sectorDetailDto)
    {
        await InvokeAsync(async () =>
        {
            await LoadMovementsAsync();
            StateHasChanged();
        });
    }

    async Task LoadAsync()
    {
        loading = true;
        try
        {
            sector = await GameService.GetSectorAsync(SectorId);
            if (sector is not null)
            {
                if (AppState.PlayerId > 0)
                    fleet = await GameService.GetFleetAsync(AppState.PlayerId);

                await LoadMovementsAsync();
            }
        }
        catch (Exception ex)
        {
            message = ex.Message;
            severity = Severity.Error;
        }
        finally
        {
            loading = false;
        }
    }

    async Task LoadMovementsAsync()
    {
        if (AppState.PlayerId <= 0) return;
        try
        {
            movements = await GameService.GetPlayerMovementsAsync(AppState.PlayerId);
            incomingZoneIds = movements
                .Where(m => m.IsEnRoute && m.ToZoneId > 0)
                .Select(m => m.ToZoneId)
                .ToHashSet();

            if (movements.Any(m => m.Resolved))
            {
                sector = await GameService.GetSectorAsync(SectorId);
                fleet = await GameService.GetFleetAsync(AppState.PlayerId);
            }

            StateHasChanged();
        }
        catch
        {
        }
    }

    async Task OpenActionDialog(ZoneDto zone)
    {
        var parameters = new DialogParameters<SectorActionDialog>
        {
            { d => d.Zone, zone },
            { d => d.PlayerFleet, fleet }
        };
        var options = new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Small, CloseButton = true };
        var dialog = await DialogService.ShowAsync<SectorActionDialog>("", parameters, options);
        var result = await dialog.Result;

        if (result?.Canceled != false || result.Data is not List<FleetCompositionDto> composition)
            return;

        var isClaim = !zone.IsClaimed;
        try
        {
            FleetMovementDto? movement = isClaim
                ? await GameService.ClaimZoneAsync(zone.Id, AppState.PlayerId, composition)
                : await GameService.AttackZoneAsync(zone.Id, AppState.PlayerId, composition);

            if (movement is not null)
            {
                var min = (int)Math.Ceiling(movement.TimeUntilArrival.TotalMinutes);
                message = $"Fleet dispatched to R{movement.Ring}-P{movement.Position}! Arriving in ~{min} min.";
                severity = Severity.Info;
                await LoadAsync();
            }
        }
        catch (Exception ex)
        {
            message = ex.Message;
            severity = Severity.Error;
        }
    }

    async Task OpenManageDialog(ZoneDto zone)
    {
        var freshZone = await GameService.GetZoneAsync(zone.Id);
        if (freshZone is null) return;

        var parameters = new DialogParameters<ZoneDetailDialog>
        {
            { d => d.Zone, freshZone },
            { d => d.PlayerFleet, fleet }
        };
        var options = new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Small, CloseButton = true };
        var dialog = await DialogService.ShowAsync<ZoneDetailDialog>("", parameters, options);
        var result = await dialog.Result;

        if (result?.Canceled != false || result.Data is not List<FleetCompositionDto> composition)
            return;

        try
        {
            var movement = await GameService.ReinforceZoneAsync(zone.Id, AppState.PlayerId, composition);
            if (movement is not null)
            {
                var min = (int)Math.Ceiling(movement.TimeUntilArrival.TotalMinutes);
                message = $"Reinforcements dispatched to R{movement.Ring}-P{movement.Position}! Arriving in ~{min} min.";
                severity = Severity.Info;
                await LoadAsync();
            }
        }
        catch (Exception ex)
        {
            message = ex.Message;
            severity = Severity.Error;
        }
    }

    static string ZoneCardClass(bool isIncoming) => isIncoming ? "zone-card zone-incoming" : "zone-card";

    static string MovementCardClass(FleetMovementDto mv) => mv.Resolved ? "mb-2 movement-card movement-resolved" : "mb-2 movement-card movement-enroute";

    static string FormatTime(TimeSpan t)
    {
        if (t.TotalSeconds <= 0) return "now";
        if (t.TotalMinutes >= 1) return $"{(int)t.TotalMinutes}m {t.Seconds}s";
        return $"{t.Seconds}s";
    }

    static string BoostCssClass(ResourceType type) => type switch
    {
        ResourceType.Metal => "default",
        ResourceType.Energy => "warning",
        ResourceType.Food => "success",
        ResourceType.Water => "info",
        _ => "default"
    };

    public async ValueTask DisposeAsync()
    {
        if (hubConnection is not null)
        {
            await hubConnection.DisposeAsync();
        }
    }
}
