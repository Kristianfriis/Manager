@baseUrl = http://localhost:5261

### Create a new planet
# @name createPlanet
POST {{baseUrl}}/api/planets
Content-Type: application/json

{ "name": "Earth II" }

### Get planet by ID (uses ID from create response)
GET {{baseUrl}}/api/planets/{{createPlanet.response.body.$.id}}

### Collect/refresh resources (simulates time passing)
POST {{baseUrl}}/api/planets/{{createPlanet.response.body.$.id}}/collect

### Upgrade Metal production to level 2
POST {{baseUrl}}/api/planets/{{createPlanet.response.body.$.id}}/upgrade
Content-Type: application/json

{ "resourceType": 3 }

### Upgrade Food production to level 2
POST {{baseUrl}}/api/planets/{{createPlanet.response.body.$.id}}/upgrade
Content-Type: application/json

{ "resourceType": 0 }

### Upgrade Water production to level 2
POST {{baseUrl}}/api/planets/{{createPlanet.response.body.$.id}}/upgrade
Content-Type: application/json

{ "resourceType": 1 }

### Upgrade Energy production to level 2
POST {{baseUrl}}/api/planets/{{createPlanet.response.body.$.id}}/upgrade
Content-Type: application/json

{ "resourceType": 2 }

### Collect after upgrades
POST {{baseUrl}}/api/planets/{{createPlanet.response.body.$.id}}/collect

### Try to get a non-existent planet (should return 404)
GET {{baseUrl}}/api/planets/9999
