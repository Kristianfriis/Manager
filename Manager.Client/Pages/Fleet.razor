@page "/fleet"
@using Manager.Client.Services
@inject GameService GameService
@inject NavigationManager Navigation
@inject AppState AppState

<PageTitle>Fleet Overview</PageTitle>

@if (!string.IsNullOrEmpty(message))
{
    <MudAlert Severity="@severity" Class="mb-4">@message</MudAlert>
}

@if (AppState.PlayerId > 0)
{
    <MudText Typo="Typo.h4" Class="mb-4">@AppState.PlayerName's Fleet</MudText>

    @if (fleet.Count > 0)
    {
        <MudTable Items="fleet" Dense="true" Class="mb-4">
            <HeaderContent>
                <MudTh>Type</MudTh>
                <MudTh>Count</MudTh>
                <MudTh>Health</MudTh>
                <MudTh>Attack</MudTh>
                <MudTh>Speed</MudTh>
                <MudTh>Metal Cost</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Type"><strong>@context.Type</strong></MudTd>
                <MudTd DataLabel="Count">@context.Count</MudTd>
                <MudTd DataLabel="Health">@context.Stats?.BaseHealth</MudTd>
                <MudTd DataLabel="Attack">@context.Stats?.AttackDamage</MudTd>
                <MudTd DataLabel="Speed">@context.Stats?.Speed</MudTd>
                <MudTd DataLabel="Cost">@context.Stats?.MetalCost</MudTd>
            </RowTemplate>
        </MudTable>

        <MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
            Total ships: <strong>@fleet.Sum(f => f.Count)</strong>
        </MudText>
    }
    else
    {
        <MudAlert Severity="Severity.Info" Class="mb-4">No ships in your fleet yet. Build ships at your planets' shipyards.</MudAlert>
    }

    @if (movements.Count > 0)
    {
        <MudPaper Class="pa-4 mt-4">
            <MudText Typo="Typo.h6">Active Fleet Movements</MudText>
            @foreach (var mv in movements.OrderBy(m => m.ArrivalTime))
            {
                <MudCard Outlined="true" Class="@MovementCardClass(mv)">
                    <MudCardContent>
                        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                            <MudIcon Icon="@Icons.Material.Filled.Flight"
                                     Class="@(mv.IsEnRoute ? "mud-info-text" : mv.AttackerWon == true ? "mud-success-text" : "mud-error-text")" />
                            <MudText Typo="Typo.body2">
                                @(mv.IsClaim ? "Claim" : "Attack") — R@(mv.Ring)-P@(mv.Position)
                            </MudText>
                            <MudText Typo="Typo.body2" Class="mud-text-secondary">
                                @mv.ShipCount ship@(mv.ShipCount > 1 ? "s" : "")
                            </MudText>
                        </MudStack>
                        @if (mv.IsEnRoute)
                        {
                            <MudText Typo="Typo.body2" Class="mud-info-text mt-1">
                                Arriving in @FormatTime(mv.TimeUntilArrival)…
                            </MudText>
                        }
                        else if (mv.Resolved)
                        {
                            <MudText Typo="Typo.body2" Class="mt-1">
                                @if (mv.AttackerWon == true)
                                {
                                    <span class="mud-success-text">Victory!</span>
                                }
                                else
                                {
                                    <span class="mud-error-text">Defeated!</span>
                                }
                            </MudText>
                        }
                    </MudCardContent>
                </MudCard>
            }
        </MudPaper>
    }

    <MudPaper Class="pa-4 mt-4">
        <MudText Typo="Typo.h6">Quick Actions</MudText>
        <MudStack Row="true" Spacing="2" Class="mt-2">
            <MudButton Variant="Variant.Filled" Color="Color.Success"
                       OnClick="@(() => Navigation.NavigateTo("/sectors"))">
                View Sectors
            </MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Tertiary"
                       OnClick="@(() => Navigation.NavigateTo("/planets"))">
                View Planets
            </MudButton>
        </MudStack>
    </MudPaper>
}
else
{
    <MudAlert Severity="Severity.Info" Class="mt-4">Create a player first on the home page.</MudAlert>
}

@code {
    string? message;
    Severity severity = Severity.Normal;
    bool Loading;
    List<FleetDto> fleet = [];
    List<FleetMovementDto> movements = [];

    protected override async Task OnInitializedAsync()
    {
        if (string.IsNullOrWhiteSpace(AppState.PlayerName))
        {
            Navigation.NavigateTo("/");
            return;
        }

        await LoadFleetAsync();
    }

    async Task LoadFleetAsync()
    {
        Loading = true;
        try
        {
            fleet = await GameService.GetFleetAsync(AppState.PlayerId);
            movements = await GameService.GetPlayerMovementsAsync(AppState.PlayerId);
        }
        catch
        {
            message = "Failed to load fleet data.";
            severity = Severity.Error;
        }
        finally
        {
            Loading = false;
        }
    }

    static string FormatTime(TimeSpan t)
    {
        if (t.TotalSeconds <= 0) return "now";
        if (t.TotalMinutes >= 1) return $"{(int)t.TotalMinutes}m {t.Seconds}s";
        return $"{t.Seconds}s";
    }

    static string MovementCardClass(FleetMovementDto mv) => mv.Resolved ? "mb-2 movement-resolved" : "mb-2 movement-enroute";
}
