@using Manager.Client.Services
@inject AppState AppState
@inject LocalStorageService LocalStorage
@inject ISnackbar Snackbar
@inject PlayerService PlayerService

<MudThemeProvider @ref="_mudThemeProvider" @bind-IsDarkMode="_isDarkMode" Theme="CustomThemes.Spacelabtheme"/>
<MudDialogProvider />
<MudSnackbarProvider />
<MudPopoverProvider />

<MudOverlay Visible="visible" DarkBackground="true" Absolute="true">
    <MudProgressCircular Color="Color.Secondary" Indeterminate="true" />
</MudOverlay>

<Router AppAssembly="@typeof(App).Assembly" NotFoundPage="typeof(Pages.NotFound)">
    <Found Context="routeData">
        <RouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)" />
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
</Router>


@code {
    private bool _isDarkMode;
    private MudThemeProvider? _mudThemeProvider;

    private bool visible;

    protected override async Task OnInitializedAsync()
    {
        visible = true;


        var storedPlayerName = await LocalStorage.GetItemAsync<string>("PlayerName");
        var storedPlayerId = await LocalStorage.GetItemAsync<int>("PlayerId");
        if (!string.IsNullOrWhiteSpace(storedPlayerName) && storedPlayerId > 0)
        {
            Console.WriteLine($"Found stored player: {storedPlayerName} (ID: {storedPlayerId}) from App.razor");
            var (success, player, message) = await PlayerService.GetPlayerAsync(storedPlayerId);
            if (!success)
            {
                Snackbar.Configuration.PositionClass = Defaults.Classes.Position.BottomCenter;
                Snackbar.Add(message ?? "An error occurred while retrieving the player.", Severity.Normal);
            }
            else if (player is not null)
            {
                AppState.SetPlayer(player.Name, player.Id);
            }
        }

        visible = false;
        @* StateHasChanged(); *@
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if(_mudThemeProvider is null)
        {
            Console.WriteLine("MudThemeProvider reference is null in OnAfterRenderAsync.");
            return;
        }
        if (firstRender)
        {
            _isDarkMode = await _mudThemeProvider.GetSystemDarkModeAsync();
            await _mudThemeProvider.WatchSystemDarkModeAsync(OnSystemDarkModeChanged);
            StateHasChanged();
        }
    }

    private Task OnSystemDarkModeChanged(bool newValue)
    {
        _isDarkMode = newValue;
        StateHasChanged();
        return Task.CompletedTask;
    }
}