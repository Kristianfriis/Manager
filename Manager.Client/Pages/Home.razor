@page "/"
@using Manager.Client.Components
@using Manager.Client.Models
@using Manager.Client.Services

@implements IDisposable

@inject NavigationManager Navigation
@inject AppState AppState
@inject LocalStorageService LocalStorage
@inject PlayerService PlayerService
@inject ISnackbar Snackbar

<PageTitle>Home</PageTitle>

<MudPaper Class="pa-4 mb-4">
    @if (string.IsNullOrWhiteSpace(AppState.PlayerName))
    {
        <MudText Typo="Typo.h4">Welcome to the Space Sector Manager!</MudText>
        <MudText Typo="Typo.body1" Class="mb-4">To get started, please enter a player name below and click "Set". This will
            be your identity in the game.</MudText>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudTextField @bind-Value="playerName" Label="Player Name" Variant="Variant.Outlined" />
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@SetPlayerName">Set</MudButton>
            </MudStack>
        }
    else
        {
            <MudText Typo="Typo.h4">Welcome back, @AppState.PlayerName!</MudText>
            <MudText Typo="Typo.body1" Class="mb-4">Ready to manage your fleet and conquer sectors? Click the button below to
                view available sectors and start playing.</MudText>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => Navigation.NavigateTo("/sectors"))">View
                    Sectors</MudButton>
                }
            </MudPaper>

<CustomIcon Icon="CustomIconEnum.Orbit" Size="4" />

@code {
    private string playerName = "";

    protected override async Task OnInitializedAsync()
    {
        AppState.OnChange += StateHasChanged;
    }

    async Task SetPlayerName()
    {
        if (!string.IsNullOrWhiteSpace(playerName))
        {
            var createResult = await PlayerService.CreatePlayerAsync(playerName);

            if (createResult.success && createResult.player is not null)
            {
                await LocalStorage.SetItemAsync("PlayerName", playerName);
                await LocalStorage.SetItemAsync("PlayerId", createResult.player.Id);
                AppState.SetPlayer(createResult.player.Name, createResult.player.Id);
                Navigation.NavigateTo("/sectors");
            }
            else
            {
                Snackbar.Configuration.PositionClass = Defaults.Classes.Position.BottomCenter;
                Snackbar.Add(createResult.message ?? "An error occurred while creating the player.", Severity.Normal);
            }
        }
    }

    public void Dispose()
    {
        AppState.OnChange -= StateHasChanged;
    }
}